PORT=5000
MONGODB_URI=mongodb://localhost:27017/taskflow
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
NODE_ENV=development
# Set to true only when you want the demo/dummy data seeded on a fresh empty database.
SEED_DB=false

# ── Email notifications (AWS SES) ────────────────────────────────────
# Master switch. Leave false until the sending domain is DKIM-verified AND the
# fake @company.com seed users are gone — otherwise the first task assignment
# hard-bounces a dozen addresses and SES puts the account back in its sandbox.
# While false, every email is composed and written to the EmailLog collection
# with status 'dry-run', so the whole path stays testable.
EMAIL_ENABLED=false

# Must be an address on a domain verified in SES. Unset also forces dry-run.
MAIL_FROM=no-reply@yourcompany.com
MAIL_FROM_NAME=TaskFlow
MAIL_BRAND_NAME=TaskFlow

# Public base URL, no trailing slash. Used to build the deep link in emails
# (APP_URL/?task=<id>). Unset renders the emails without a link button.
APP_URL=http://localhost:5000

# SES region. Credentials come from the standard AWS provider chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an instance role).
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── File sharing (AWS S3) ────────────────────────────────────────────
# Naming a bucket switches the feature on. While unset, the upload endpoints
# return 503 and the client hides the upload controls.
# The bucket must stay PRIVATE — all access is via short-lived presigned URLs.
S3_BUCKET=
# Per-file cap, enforced by S3 itself through the presigned POST policy.
MAX_UPLOAD_MB=25

# ── KPI & performance ────────────────────────────────────────────────
# The KPI module needs no configuration to run: default scorecards are seeded
# on boot and every score is derived from existing task and review data.
#
# These two only affect the Attendance metric, which is measured as
# "days with a submitted daily update ÷ working days in the month". Getting
# the working-day count wrong makes attendance look worse than it is.
#
# Non-working weekdays, 0=Sunday … 6=Saturday. Default is a Sat/Sun weekend;
# set to 5,6 for a Fri/Sat weekend.
# KPI_WEEKEND=0,6
#
# Public holidays, comma-separated YYYY-MM-DD. Excluded from working days so
# nobody is marked absent for a day the office was shut.
# KPI_HOLIDAYS=2026-01-01,2026-12-25
